# Copy to .env and fill in secrets. Never commit the real .env file.

# Google Gemini (required for LangGraph extraction & GraphRAG)
GEMINI_API_KEY=

# Server
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000

# Optional: WhatsApp outbound alerts (leave unset to disable)
# WHATSAPP_PROVIDER=

# Excel template profile (default: demo)
EXCEL_TEMPLATE_PROFILE=demo
